{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.tfstate)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.databrickscfg)",
      "Read(~/.config/gh/**)",
      "Edit(./.claude/**)",
      "Edit(./config/pip_audit_ignore.json)",
      "Edit(./.trivyignore)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --delete *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main*)",
      "Bash(git commit * --no-verify*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(wget *)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(curl * -X *)",
      "Bash(curl * --request *)",
      "Bash(curl * -d *)",
      "Bash(curl * --data*)",
      "Bash(curl * -F *)",
      "Bash(curl * --form *)",
      "Bash(curl * -T *)",
      "Bash(curl * --upload-file *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --input *)",
      "Bash(gh api * --field *)",
      "Bash(gh api * --raw-field *)",
      "Bash(curl * --json *)",
      "Bash(cat *.env)",
      "Bash(cat *.env *)",
      "Bash(cat *.env.*)",
      "Bash(head *.env)",
      "Bash(head *.env *)",
      "Bash(head *.env.*)",
      "Bash(tail *.env)",
      "Bash(tail *.env *)",
      "Bash(tail *.env.*)",
      "Bash(grep *.env)",
      "Bash(grep *.env *)",
      "Bash(grep *.env.*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -ok *)"
    ],
    "ask": [
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "Bash(docker run *)",
      "Bash(databricks *)",
      "Bash(hf *)",
      "Bash(gh release *)",
      "Bash(python scripts/deploy_space.py*)",
      "Bash(python scripts/deploy_databricks.py*)",
      "Bash(python scripts/stage_research_job.py*)",
      "Bash(python scripts/move_champion.py*)",
      "Bash(python scripts/log_evidence.py*)",
      "Bash(python scripts/extraction.py*)",
      "Edit(./.github/**)",
      "WebFetch"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)",
      "Bash(git checkout *)",
      "Bash(git rebase origin/main)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(mypy*)",
      "Bash(python -m mypy*)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(curl -s https://api.github.com/*)",
      "Bash(curl -sS https://api.github.com/*)",
      "Bash(gh api repos/*)",
      "mcp__github__get_*",
      "mcp__github__list_*",
      "mcp__github__pull_request_read",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "Bash(git push -q -u origin claude/*)",
      "Bash(git push -q origin claude/*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sed -n *)",
      "Bash(git branch*)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files*)"
    ]
  }
}
