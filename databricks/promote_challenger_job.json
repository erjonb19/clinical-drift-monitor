{
  "name": "cdm-item17-promote-challenger",
  "max_concurrent_runs": 1,
  "email_notifications": {
    "on_failure": [
      "{{DATABRICKS_USER}}"
    ],
    "on_success": [
      "{{DATABRICKS_USER}}"
    ]
  },
  "environments": [
    {
      "environment_key": "cpu",
      "spec": {
        "environment_version": "4",
        "dependencies": [
          "STAGE_FIRST",
          "torch==2.14.0",
          "torchvision==0.29.0",
          "mlflow==3.17.1"
        ]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "promote_challenger",
      "environment_key": "cpu",
      "max_retries": 0,
      "retry_on_timeout": false,
      "timeout_seconds": 1800,
      "notebook_task": {
        "notebook_path": "/Users/{{DATABRICKS_USER}}/cdm/promote_challenger",
        "base_parameters": {
          "code_version": "STAGE_FIRST",
          "wheel": "STAGE_FIRST",
          "wheel_sha256": "STAGE_FIRST",
          "version": "",
          "expect_current": "",
          "decision_path": "",
          "decision_sha256": "",
          "job_run_id": "{{job.run_id}}"
        }
      }
    }
  ]
}
