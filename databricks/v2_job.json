      "max_retries": 1,
      "min_retry_interval_millis": 0,
      "retry_on_timeout": false,
      "timeout_seconds": 9000,
      "notebook_task": {
        "notebook_path": "/Users/erjonbrucaj@gmail.com/cdm/overnight_gpu",
        "base_parameters": {
          "wheel": "/Volumes/workspace/cdm/raw/deploy/932865b/cdm-0.1.0-py3-none-any.whl",
          "code_version": "932865b",
          "config": "{\"arch\": \"b0\", \"image_size\": 224, \"view\": \"center\", \"epochs\": 12}",
          "rounds": "20",
          "proximal_mu": "0.01",
          "deadline_minutes": "115",
          "job_run_id": "{{job.run_id}}",
          "pause_when_done": "",
          "hardened_workers": "2",
          "version": "v2"
        }
      }
    }
  ]
