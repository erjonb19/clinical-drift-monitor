{
  "name": "{{PIPELINE_NAME}}",
  "catalog": "{{CATALOG}}",
  "schema": "{{SCHEMA}}",
  "serverless": true,
  "continuous": false,
  "development": false,
  "channel": "CURRENT",
  "libraries": [{"file": {"path": "{{PIPELINE_FILE}}"}}],
  "environment": {"dependencies": ["{{WHEEL}}"]},
  "configuration": {
    "pipelines.numUpdateRetryAttempts": "0",
    "cdm.config": "{{CONFIG}}",
    "cdm.images_glob": "{{IMAGES_GLOB}}",
    "cdm.metadata_path": "{{METADATA_PATH}}",
    "cdm.manifest_path": "{{MANIFEST_PATH}}"
  },
  "tags": {"code_version": "{{SHA}}"}
}
