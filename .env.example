# Environment variables this code reads, by name only: never put a real value in this file.
# Only ANTHROPIC_API_KEY is read from a .env file (src/cdm/extract.py, which also reads the
# environment); everything else is read from the shell environment. The optional variables are
# commented out with the default the code uses when they are unset; setting one to an empty
# value is not the same as leaving it unset.

# The one paid key: Claude Haiku for G5 extraction, capped at $5 (src/cdm/extract.py).
ANTHROPIC_API_KEY=

# The drift watchdog's view-only service principal (scripts/watchdog.py). In CI these are
# repository secrets.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Optional, shown with their defaults.
# Data root, outside the repository (src/cdm/data.py).
# CDM_DATA=data
# G5 note work folder, outside the repository (scripts/extraction.py).
# CDM_NOTES_DIR=~/data/mtsamples/work
# Tier-2 notes: set to 1 only where a data use agreement allows them (src/cdm/extract.py).
# CDM_TIER2=
# The API (app/api/main.py): the serving bundle, and how many proxies to trust for the client
# address (the Docker image sets 1).
# BUNDLE_DIR=/app/bundle
# TRUSTED_PROXY_HOPS=0
