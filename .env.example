# Copy to .env (gitignored) and fill in locally. Names only here: never put a real value in
# this file. Each variable is read by name in the code shown.

# The one paid key: Claude Haiku for G5 extraction, capped at $5 (src/cdm/extract.py).
ANTHROPIC_API_KEY=

# The drift watchdog's view-only service principal (scripts/watchdog.py). In CI these are
# repository secrets, not a .env file.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Local data and work folders (outside the repository).
CDM_DATA=
CDM_NOTES_DIR=
# Set to 1 only where a data use agreement allows tier-2 notes (src/cdm/extract.py).
CDM_TIER2=

# The API (app/api/main.py): the serving bundle folder, and proxy hops to trust for the
# client address (0 when the API is reached directly).
BUNDLE_DIR=
TRUSTED_PROXY_HOPS=
